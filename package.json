{
  "name": "culinary-lab-book",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "eval": "AI_CACHE=off node --env-file=.env.local --import tsx evals/run.ts",
    "models": "node --env-file=.env.local --import tsx evals/models.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "check-env": "node --env-file=.env.local scripts/check-env.mjs",
    "verify": "node --env-file=.env.local ./node_modules/@playwright/test/cli.js test verify/verify.spec.ts",
    "verify:fresh": "rm -rf .ai-cache && npm run verify",
    "words": "node --env-file=.env.local ./node_modules/@playwright/test/cli.js test verify/words.spec.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.10.0",
    "@google/genai": "^3.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@clerk/testing": "^2.3.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
